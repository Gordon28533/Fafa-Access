# Database
DATABASE_URL=postgresql://adminuser:password@localhost:5432/laptop_app?sslmode=prefer
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=5000

# Server
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
COOKIE_SECRET=replace-with-secure-cookie-secret
JWT_SECRET=replace-with-secure-jwt-secret-min-32-characters

# Monitoring (optional)
SENTRY_DSN=
LOG_LEVEL=debug
DATADOG_ENABLED=false
DATADOG_ENV=development
DATADOG_SERVICE=laptop-access-api

# Email Providers
EMAIL_PROVIDER=smtp
EMAIL_FROM=noreply@example.com

# SendGrid
SENDGRID_API_KEY=

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# SMS / WhatsApp
HUBTEL_API_KEY=
HUBTEL_CLIENT_ID=
HUBTEL_SENDER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v19.0

# Storage
STORAGE_PROVIDER=azure
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_KEY=
AZURE_STORAGE_CONTAINER=laptop-app-files

# Redis (optional)
REDIS_URL=redis://localhost:6379
