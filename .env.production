# ============================================================================
# PRODUCTION ENVIRONMENT CONFIGURATION (.env.production)
# ============================================================================
# IMPORTANT: This is a TEMPLATE. Do NOT commit actual values to git.
# Generate secure values using:
#   - JWT_SECRET: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   - COOKIE_SECRET: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ============================================================================

# ===== CRITICAL SECURITY SETTINGS =====
# Node environment (required: production)
NODE_ENV=production

# ===== DATABASE CONFIGURATION =====
# PostgreSQL connection URL - must point to production database
# Format: postgresql://username:password@host:port/database
# DO NOT use localhost - use managed database service (RDS, Azure PostgreSQL, Heroku Postgres, etc.)
DATABASE_URL=postgresql://prod_user:CHANGE_ME@prod-db-host.region.amazonaws.com:5432/fafa_access_prod

# Connection pool settings for production
DB_POOL_MIN=5
DB_POOL_MAX=20
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=5000

# ===== JWT & AUTHENTICATION =====
# JWT Secret - MUST be at least 32 characters, cryptographically random
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NEVER use development values
JWT_SECRET=CHANGE_ME_TO_SECURE_RANDOM_VALUE_AT_LEAST_32_CHARS

# Cookie secret - for session cookie encryption
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=CHANGE_ME_TO_SECURE_RANDOM_VALUE_FOR_COOKIES

# ===== SERVER CONFIGURATION =====
# Server port - typically 5000 or 443 behind a reverse proxy
PORT=5000

# Frontend URL - required for CORS validation
# Should match your production frontend domain
FRONTEND_URL=https://www.fafa-access.edu.gh

# Optional: Alternative frontend URLs for staging/testing
VITE_APP_URL=https://www.fafa-access.edu.gh

# ===== EMAIL CONFIGURATION =====
# Email provider: smtp, sendgrid, or resend
EMAIL_PROVIDER=sendgrid

# Email display settings
EMAIL_FROM_NAME=Fafa Access
EMAIL_FROM_ADDRESS=noreply@fafaaccess.edu.gh

# SendGrid API Key (for EMAIL_PROVIDER=sendgrid)
# Get from: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=CHANGE_ME_TO_PRODUCTION_SENDGRID_KEY

# Alternative: SMTP Configuration (for EMAIL_PROVIDER=smtp)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=true
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-specific-password

# Alternative: Resend Configuration (for EMAIL_PROVIDER=resend)
# RESEND_API_KEY=re_CHANGE_ME_TO_PRODUCTION_RESEND_KEY

# Email retry configuration
EMAIL_MAX_RETRIES=3
EMAIL_RETRY_DELAY_MS=1000

# ===== LOGGING & MONITORING =====
# Log level: debug, info, warn, error, fatal
# Recommendation: info for production (debug is verbose)
LOG_LEVEL=info

# Sentry DSN for error tracking
# Get from: https://sentry.io
# This enables real-time error monitoring and alerting
SENTRY_DSN=https://CHANGE_ME@sentry.io/PROJECT_ID

# Sentry sampling rates (performance monitoring)
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.05

# ===== OPTIONAL: AWS S3 CONFIGURATION (if using S3 for document storage) =====
# AWS_REGION=eu-west-1
# AWS_BUCKET_NAME=fafa-access-documents
# AWS_ACCESS_KEY_ID=CHANGE_ME
# AWS_SECRET_ACCESS_KEY=CHANGE_ME

# ===== OPTIONAL: SMTP for Production Email =====
# Mailtrap or other SMTP service
# SMTP_HOST=smtp.mailtrap.io
# SMTP_PORT=587
# SMTP_USER=CHANGE_ME
# SMTP_PASSWORD=CHANGE_ME

# ===== OPTIONAL: PAYMENT GATEWAY (Paystack) =====
# PAYSTACK_PUBLIC_KEY=pk_live_CHANGE_ME
# PAYSTACK_SECRET_KEY=sk_live_CHANGE_ME

# ===== OPTIONAL: REDIS CONFIGURATION (if using for caching) =====
# REDIS_URL=redis://prod-redis-host:6379

# ===== OPTIONAL: CDN CONFIGURATION =====
# CDN_URL=https://cdn.fafa-access.edu.gh

# ===== VAPID KEYS FOR PUSH NOTIFICATIONS (if enabling push notifications) =====
# VAPID_PUBLIC_KEY=CHANGE_ME
# VAPID_PRIVATE_KEY=CHANGE_ME

# ===== SECURITY HEADERS =====
# Content Security Policy (if needed)
# CSP_DIRECTIVE=default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'

# ===== SUPABASE CONFIGURATION (optional, for Supabase integration) =====
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_PUBLISHABLE_KEY=CHANGE_ME

# ===== FEATURES & FLAGS =====
# Enable/disable features
ENABLE_2FA=true
ENABLE_PUSH_NOTIFICATIONS=false
ENABLE_ANALYTICS=false

# ===== RATE LIMITING (set in code, shows expected values) =====
# Currently set in server.js
# Global rate limit: 100 requests per 15 minutes
# Auth endpoint: 5 failed attempts per 15 minutes
# API endpoints: 30 requests per minute
